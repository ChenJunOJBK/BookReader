<Application x:Class="YueDu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YueDu"
             xmlns:vm="clr-namespace:YueDu.ViewModels"
             xmlns:v="clr-namespace:YueDu.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:BookShelfViewModel}">
            <v:BookShelfView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderViewModel}">
            <v:ReaderView/>
        </DataTemplate>
    </Application.Resources>
</Application>
