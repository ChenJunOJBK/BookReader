<UserControl x:Class="YueDu.Views.BookShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:YueDu.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#5a4a3a"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1a000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#6b4f8a" Padding="20,14">
            <DockPanel>
                <TextBlock Text="悦读" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="  我的书架" Foreground="#e0d8ea" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Foreground="White"
                        Content="＋ 导入TXT" Padding="14,6" FontSize="14"
                        Click="Import_Click"/>
            </DockPanel>
        </Border>

        <!-- 书架列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <ItemsControl x:Name="BooksItems" ItemsSource="{Binding Books}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Height="240" Margin="10" CornerRadius="8"
                                Background="#f5f0e6" BorderBrush="#d8cfc0" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonUp="Book_Click"
                                Tag="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 书脊装饰 -->
                                <Border Grid.Row="0" Background="#8a6fad" CornerRadius="0,8,0,0" Width="6" HorizontalAlignment="Left"/>

                                <StackPanel Grid.Row="0" Margin="18,16,12,8">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                                               Foreground="#3a2f4a" TextWrapping="Wrap"
                                               MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Author}" FontSize="12" Foreground="#8a7a6a" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- 进度条 -->
                                <Border Grid.Row="1" Margin="12,0">
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                 Height="4" Background="#e0d8cc" Foreground="#8a6fad" BorderThickness="0"/>
                                </Border>

                                <!-- 底部信息 -->
                                <StackPanel Grid.Row="2" Margin="12,6,12,10" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ChapterCount, StringFormat={}{0}章}" FontSize="11" Foreground="#8a7a6a"/>
                                    <Button Content="✕" Style="{StaticResource IconButton}" FontSize="14"
                                            HorizontalAlignment="Right" Margin="0,0,0,0" Padding="6,0"
                                            Click="Delete_Click" Tag="{Binding}"
                                            ToolTip="删除"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
