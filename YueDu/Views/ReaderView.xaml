<UserControl x:Class="YueDu.Views.ReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#6b4f8a"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{Binding BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="0,0,12,12">
            <DockPanel Margin="16,10">
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                        Content="← 返回" Click="Back_Click"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                        Content="目录" Click="ChapterPanel_Click" Margin="8,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="上一章"
                            Click="Prev_Click" Margin="4,0"/>
                    <TextBlock Text="{Binding ChapterDisplay}" Foreground="White" VerticalAlignment="Center"
                               FontSize="13" Margin="8,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="下一章"
                            Click="Next_Click" Margin="4,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ChapterTitle}" Foreground="White" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="20,0"/>
            </DockPanel>
        </Border>

        <!-- 阅读区 -->
        <ScrollViewer x:Name="ReadingScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="60,30">
            <TextBlock Text="{Binding ChapterContent}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       LineHeight="{Binding LineHeightPixels}"
                       LineStackingStrategy="BlockLineHeight"
                       Foreground="{Binding ForegroundBrush}"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- 章节目录面板（左侧滑出） -->
        <Border Grid.Row="1" Visibility="{Binding IsChapterPanelOpen, Converter={StaticResource BoolToVis}}"
                Background="#f5f0e6" Width="300" HorizontalAlignment="Left"
                Panel.ZIndex="10" BorderBrush="#d8cfc0" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 面板标题栏 -->
                <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="16,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="✕"
                                Click="CloseChapterPanel_Click"/>
                        <TextBlock Text="目录" Foreground="White" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <!-- 章节列表 -->
                <ListBox x:Name="ChapterListBox"
                         ItemsSource="{Binding ChapterList}"
                         DisplayMemberPath="Title"
                         SelectedIndex="{Binding ChapterIndex, Mode=OneWay}"
                         Background="Transparent" BorderThickness="0"
                         Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ChapterList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="#5a4632"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}" Margin="2,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1a6b4f8a"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#336b4f8a"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 底部工具栏 -->
        <Border Grid.Row="2" Background="{StaticResource AccentBrush}" CornerRadius="12,12,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,8">
                    <!-- 字号 -->
                    <Button Style="{StaticResource ToolButton}" Content="A-" Click="FontDec_Click" Margin="2,0"/>
                    <TextBlock Text="{Binding FontSize, StringFormat={}{0}号}" Foreground="White" VerticalAlignment="Center"
                               FontSize="13" Width="50" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource ToolButton}" Content="A+" Click="FontInc_Click" Margin="2,0"/>

                    <Border Background="#66ffffff" Width="1" Margin="12,4" VerticalAlignment="Stretch"/>

                    <!-- 主题 -->
                    <Button Style="{StaticResource ToolButton}" Content="日间" Click="ThemeLight_Click" Margin="2,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="护眼" Click="ThemeSepia_Click" Margin="2,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="夜间" Click="ThemeDark_Click" Margin="2,0"/>

                    <Border Background="#66ffffff" Width="1" Margin="12,4" VerticalAlignment="Stretch"/>

                    <!-- 听书控制 -->
                    <Button Style="{StaticResource ToolButton}"
                            Content="{Binding SpeakButtonText}" Click="Speak_Click" Margin="2,0" FontWeight="Bold"/>
                    <Button Style="{StaticResource ToolButton}" Content="停止" Click="Stop_Click" Margin="2,0"/>

                    <Border Background="#66ffffff" Width="1" Margin="12,4" VerticalAlignment="Stretch"/>

                    <!-- 语速 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="语速" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="90" Minimum="-10" Maximum="10" Value="{Binding TtsRate}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </StackPanel>

                    <Border Background="#66ffffff" Width="1" Margin="12,4" VerticalAlignment="Stretch"/>

                    <!-- 音量 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="音量" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider Width="80" Minimum="0" Maximum="100" Value="{Binding TtsVolume}"/>
                    </StackPanel>

                    <Border Background="#66ffffff" Width="1" Margin="12,4" VerticalAlignment="Stretch"/>

                    <!-- 语音选择 -->
                    <ComboBox ItemsSource="{Binding Voices}" SelectedValue="{Binding SelectedVoice}"
                              SelectedValuePath="VoiceInfo.Name" Width="140" VerticalAlignment="Center"
                              DisplayMemberPath="VoiceInfo.Name"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
